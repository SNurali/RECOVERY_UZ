# ============================================================
# RECOVERY.UZ — environment variables
# Copy to .env for local dev, or to .env on server for production.
# ============================================================

# Server
PORT=3004
JWT_SECRET=please-change-me-min-32-chars

# Database
DB_HOST=localhost
DB_PORT=5436
DB_USER=recovery_admin
DB_PASSWORD=recovery_secret
DB_NAME=recovery_uz

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Frontend (Vite). For local dev keep absolute URL,
# for production build use /v1 (same-origin via nginx).
VITE_API_URL=http://localhost:3004/v1
